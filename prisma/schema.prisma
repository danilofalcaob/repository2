// Schema do app de Passagem de Plantão Médico (I-PASS).
//
// Banco: SQLite em desenvolvimento/demonstração.
// Para produção (PostgreSQL): troque `provider = "postgresql"` e ajuste a
// DATABASE_URL. Os tipos abaixo evitam recursos específicos do SQLite, então a
// migração é direta. Enums são representados como String + constantes validadas
// na camada de aplicação (src/lib/constants.ts) para manter compatibilidade
// entre SQLite e Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade / acesso
// ---------------------------------------------------------------------------

model Usuario {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  senhaHash         String
  registro          String? // CRM/COREN/CREFITO/CRESS...
  perfil            String   @default("plantonista") // plantonista | profissional | coordenador | admin
  // Disciplina assistencial (medicina, enfermagem, fisioterapia, serviço social...).
  // Define a "caixa de entrada" do profissional no CRM de deshospitalização.
  disciplina        String? // ver DISCIPLINAS em src/lib/constants.ts
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  setores           UsuarioSetor[]
  sessoes           Sessao[]
  turnos            Turno[]            @relation("MedicoResponsavel")
  passagensQuePassa PassagemEvento[]   @relation("MedicoPassa")
  passagensQueRecebe PassagemEvento[]  @relation("MedicoRecebe")
  reconhecimentos   Reconhecimento[]
  logs              LogAuditoria[]

  // CRM de deshospitalização
  jornadasGeridas   Jornada[]          @relation("GestorCaso")
  barreiras         Barreira[]         @relation("ResponsavelBarreira")
  tarefas           TarefaJornada[]    @relation("ResponsavelTarefa")
  interacoes        InteracaoJornada[]
  movimentacoes     MovimentacaoEtapa[]
  equipes           MembroEquipe[]
  criteriosAvaliados CriterioAlta[]    @relation("AvaliadorCriterio")
}

// Vínculo N:N entre usuário e setor (controle de acesso por setor).
model UsuarioSetor {
  id        String  @id @default(cuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  setor     Setor   @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId   String

  @@unique([usuarioId, setorId])
}

model Sessao {
  id        String   @id @default(cuid())
  token     String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
}

// ---------------------------------------------------------------------------
// Configuração organizacional (multi-setor / multi-instituição)
// ---------------------------------------------------------------------------

model Setor {
  id           String   @id @default(cuid())
  nome         String
  instituicao  String   @default("Instituição Demonstração")
  tipo         String   @default("PS") // PS | enfermaria | UTI | outro
  // Configurações flexíveis (campos exibidos, tipos de turno) em JSON string.
  configJson   String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  usuarios     UsuarioSetor[]
  turnos       Turno[]
  pacientes    Paciente[]
  passagens    PassagemEvento[]
  jornadas     Jornada[]
}

model Turno {
  id            String   @id @default(cuid())
  setor         Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId       String
  tipo          String   @default("diurno") // diurno | noturno | custom
  rotulo        String? // ex.: "Plantão Diurno 07h-19h"
  inicio        DateTime
  fim           DateTime?
  responsavel   Usuario? @relation("MedicoResponsavel", fields: [responsavelId], references: [id])
  responsavelId String?

  passagensSaida   PassagemEvento[] @relation("TurnoSai")
  passagensEntrada PassagemEvento[] @relation("TurnoEntra")
}

// ---------------------------------------------------------------------------
// Pacientes (cadastro manual no app — sem integração com PEP)
// ---------------------------------------------------------------------------

model Paciente {
  id                String   @id @default(cuid())
  setor             Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId           String
  identificador     String // identificador interno fictício
  leito             String?
  idade             Int?
  sexo              String? // F | M | outro
  dataAdmissao      DateTime @default(now())
  diagnosticoPrincipal String?
  alergias          String?
  status            String   @default("ativo") // ativo | alta | obito | transferido
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  snapshots    SnapshotPaciente[]
  pendencias   Pendencia[]
  contingencias Contingencia[]
  eventosTRR   EventoTRR[]
  jornadas     Jornada[]
}

// ---------------------------------------------------------------------------
// Passagem de plantão (handoff)
// ---------------------------------------------------------------------------

model PassagemEvento {
  id             String   @id @default(cuid())
  setor          Setor    @relation(fields: [setorId], references: [id])
  setorId        String
  turnoSai       Turno?   @relation("TurnoSai", fields: [turnoSaiId], references: [id])
  turnoSaiId     String?
  turnoEntra     Turno?   @relation("TurnoEntra", fields: [turnoEntraId], references: [id])
  turnoEntraId   String?
  medicoPassa    Usuario  @relation("MedicoPassa", fields: [medicoPassaId], references: [id])
  medicoPassaId  String
  medicoRecebe   Usuario? @relation("MedicoRecebe", fields: [medicoRecebeId], references: [id])
  medicoRecebeId String?
  inicioEm       DateTime @default(now())
  concluidaEm    DateTime?
  status         String   @default("rascunho") // rascunho | concluida
  duracaoSeg     Int? // duração em segundos (cálculo no fechamento)

  snapshots      SnapshotPaciente[]
  reconhecimentos Reconhecimento[]
  eventosTRR     EventoTRR[]
}

// Snapshot IMUTÁVEL dos campos I-PASS de um paciente no momento da passagem.
// Edições durante o rascunho atualizam o registro; uma vez concluída a passagem,
// o snapshot nunca mais é alterado. Versões anteriores ficam em SnapshotVersao.
model SnapshotPaciente {
  id              String   @id @default(cuid())
  passagem        PassagemEvento @relation(fields: [passagemId], references: [id], onDelete: Cascade)
  passagemId      String
  paciente        Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId      String

  // I-PASS
  gravidade       String   @default("estavel") // estavel | cuidado | instavel (I)
  resumoPaciente  String   @default("") // P
  // Ações (A) e contingências (S) vivem em tabelas próprias, mas são "congeladas"
  // como texto no fechamento (campos abaixo) para garantir imutabilidade.
  acoesSnapshot   String? // JSON congelado das pendências no momento
  contingenciasSnapshot String? // JSON congelado das contingências no momento
  sinteseReceptor String? // S — síntese de quem recebe

  // Preocupação / intuição clínica
  nivelPreocupacao String  @default("baixo") // baixo | medio | alto
  oQueMePreocupa   String?

  // "O que mudou desde a última passagem" (gerado/anotado)
  resumoMudancas   String?

  versao          Int      @default(1)
  imutavel        Boolean  @default(false) // true após conclusão da passagem
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  reconhecido     Boolean  @default(false)
  versoes         SnapshotVersao[]

  @@unique([passagemId, pacienteId])
}

// Versionamento append-only de snapshots (defensibilidade médico-legal).
model SnapshotVersao {
  id          String   @id @default(cuid())
  snapshot    SnapshotPaciente @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId  String
  versao      Int
  dadosJson   String // cópia integral dos campos naquele momento
  criadoEm    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Pendências (action items) — com responsável, prazo, herança entre turnos
// ---------------------------------------------------------------------------

model Pendencia {
  id            String   @id @default(cuid())
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pacienteId    String
  descricao     String
  responsavel   String?
  prazo         DateTime?
  prioridade    String   @default("media") // baixa | media | alta
  status        String   @default("aberta") // aberta | concluida | cancelada
  herdada       Boolean  @default(false)
  // Encadeamento de herança entre turnos (aponta para a pendência original).
  origemId      String?
  criadaEm      DateTime @default(now())
  concluidaEm   DateTime?
  historicoJson String? // histórico de alterações em JSON
}

// ---------------------------------------------------------------------------
// Contingências (rede de segurança) — item estruturado de primeira classe
// ---------------------------------------------------------------------------

model Contingencia {
  id            String   @id @default(cuid())
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pacienteId    String
  parametro     String // ex.: "SatO2"
  limiar        String // ex.: "< 90%"
  acao          String // ex.: "iniciar O2 e chamar plantonista"
  prioridade    String   @default("alta") // baixa | media | alta
  status        String   @default("ativa") // ativa | reconhecida | disparada | resolvida
  reconhecidaPor String?
  reconhecidaEm DateTime?
  lembreteEm    DateTime?
  dispradaEm    DateTime?
  resolvidaEm   DateTime?
  criadaEm      DateTime @default(now())
}

// Read-back: reconhecimento de snapshots/contingências pelo receptor.
model Reconhecimento {
  id            String   @id @default(cuid())
  passagem      PassagemEvento @relation(fields: [passagemId], references: [id], onDelete: Cascade)
  passagemId    String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId     String
  tipo          String // snapshot | contingencia
  referenciaId  String // id do snapshot ou contingência
  criadoEm      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Time de Resposta Rápida (TRR) / deterioração clínica
// ---------------------------------------------------------------------------

model EventoTRR {
  id            String   @id @default(cuid())
  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pacienteId    String
  ocorridoEm    DateTime @default(now())
  criterio      String // critério/motivo do acionamento
  equipe        String?
  desfecho      String? // ex.: estabilizado | UTI | óbito
  // Vínculo com a passagem mais recente daquele paciente (contexto clínico).
  passagem      PassagemEvento? @relation(fields: [passagemId], references: [id])
  passagemId    String?
  // Tinha contingência/preocupação registrada antes? (cruzamento de análise)
  tinhaContingencia Boolean @default(false)
  tinhaPreocupacao  Boolean @default(false)
  criadoEm      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CRM de deshospitalização — "Jornada de Alta"
//
// Cada internação vira uma "jornada" (o equivalente ao negócio/oportunidade de
// um CRM), que percorre um FUNIL de etapas até a alta. O que trava a alta é
// registrado como BARREIRA (com dono, disciplina e prazo), as ações de cada
// profissional viram TAREFAS e toda comunicação fica na TIMELINE — de modo que
// médico, enfermagem, fisioterapia, serviço social e demais equipes trabalhem
// sobre o mesmo plano, com data de alta prevista explícita e negociada.
// ---------------------------------------------------------------------------

model Jornada {
  id                String   @id @default(cuid())
  paciente          Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  pacienteId        String
  setor             Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId           String

  // Funil (pipeline). Ver ETAPAS_JORNADA em src/lib/constants.ts.
  etapa             String   @default("admissao")
  status            String   @default("aberta") // aberta | concluida | encerrada

  // Gestor do caso (o "dono do negócio" no CRM).
  gestorCaso        Usuario? @relation("GestorCaso", fields: [gestorCasoId], references: [id])
  gestorCasoId      String?

  motivoInternacao  String?
  planoTerapeutico  String?

  // Data de Alta Prevista (DAP) — o "expected close date" do CRM.
  // A primeira previsão é guardada à parte para medir acurácia da estimativa.
  dataAltaPrevista        DateTime?
  dataAltaPrevistaInicial DateTime?
  confiancaAlta           String    @default("media") // baixa | media | alta
  destinoAlta             String? // domicilio | domicilio_apoio | home_care | ilpi | retaguarda | outro_hospital
  complexidade            String    @default("media") // baixa | media | alta
  riscoReinternacao       String    @default("baixo") // baixo | medio | alto

  altaEfetivadaEm   DateTime?
  encerradaEm       DateTime?
  encerradaMotivo   String? // obito | transferencia | evasao | outro

  // Usado para detectar jornadas "paradas" (sem movimentação da equipe).
  ultimaInteracaoEm DateTime @default(now())
  criadaEm          DateTime @default(now())
  atualizadaEm      DateTime @updatedAt

  barreiras     Barreira[]
  tarefas       TarefaJornada[]
  interacoes    InteracaoJornada[]
  criterios     CriterioAlta[]
  movimentacoes MovimentacaoEtapa[]
  equipe        MembroEquipe[]

  @@index([setorId, status])
}

// Barreira à alta: o que efetivamente segura o paciente no hospital.
// É o item central do CRM — sem dono e prazo, atraso vira rotina.
model Barreira {
  id             String   @id @default(cuid())
  jornada        Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId      String
  categoria      String // ver CATEGORIAS_BARREIRA (clinica, exame, parecer, social...)
  descricao      String
  disciplina     String // disciplina responsável por resolver
  responsavel    Usuario? @relation("ResponsavelBarreira", fields: [responsavelId], references: [id])
  responsavelId  String?
  prazo          DateTime?
  prioridade     String   @default("media") // baixa | media | alta
  // Barreira bloqueante impede a alta mesmo com critérios clínicos atingidos.
  bloqueiaAlta   Boolean  @default(true)
  impactoDias    Int? // atraso estimado em dias (para priorização e gestão)
  status         String   @default("aberta") // aberta | em_andamento | resolvida | cancelada
  resolucao      String?
  abertaEm       DateTime @default(now())
  resolvidaEm    DateTime?
  criadaPorNome  String?

  tarefas        TarefaJornada[]

  @@index([jornadaId, status])
}

// Tarefa de um profissional dentro do plano de alta (atividade do CRM).
model TarefaJornada {
  id            String   @id @default(cuid())
  jornada       Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId     String
  titulo        String
  detalhe       String?
  disciplina    String
  responsavel   Usuario? @relation("ResponsavelTarefa", fields: [responsavelId], references: [id])
  responsavelId String?
  prazo         DateTime?
  prioridade    String   @default("media")
  status        String   @default("aberta") // aberta | concluida | cancelada
  barreira      Barreira? @relation(fields: [barreiraId], references: [id], onDelete: SetNull)
  barreiraId    String?
  criadaEm      DateTime @default(now())
  concluidaEm   DateTime?
  concluidaPor  String?

  @@index([jornadaId, status])
  @@index([responsavelId, status])
}

// Timeline append-only da jornada: notas de round, decisões, conversas com a
// família, mudanças de etapa e alertas. É o "histórico de interações" do CRM e
// a memória compartilhada entre turnos e categorias profissionais.
model InteracaoJornada {
  id          String   @id @default(cuid())
  jornada     Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId   String
  autor       Usuario? @relation(fields: [autorId], references: [id])
  autorId     String?
  autorNome   String
  disciplina  String?
  tipo        String   @default("nota") // nota | round | decisao | familia | etapa | barreira | tarefa | alerta | alta
  texto       String
  // Disciplinas mencionadas (ex.: ["servico_social"]) — vira pedido direcionado.
  mencoesJson String?
  criadoEm    DateTime @default(now())

  @@index([jornadaId, criadoEm])
}

// Checklist de critérios objetivos de alta. O percentual atingido funciona
// como a "probabilidade de fechamento" do CRM.
model CriterioAlta {
  id           String   @id @default(cuid())
  jornada      Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId    String
  categoria    String // clinico | funcional | educacional | logistico
  descricao    String
  atendido     Boolean  @default(false)
  naoAplicavel Boolean  @default(false)
  avaliadoPor  Usuario? @relation("AvaliadorCriterio", fields: [avaliadoPorId], references: [id])
  avaliadoPorId String?
  avaliadoEm   DateTime?
  ordem        Int      @default(0)
  observacao   String?

  @@index([jornadaId])
}

// Histórico de movimentação no funil (tempo em cada etapa = gargalos).
model MovimentacaoEtapa {
  id         String   @id @default(cuid())
  jornada    Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId  String
  de         String?
  para       String
  motivo     String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId  String?
  usuarioNome String?
  criadoEm   DateTime @default(now())

  @@index([jornadaId, criadoEm])
}

// Equipe multiprofissional vinculada ao caso (quem acompanha o paciente).
model MembroEquipe {
  id          String   @id @default(cuid())
  jornada     Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  jornadaId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  disciplina  String
  adicionadoEm DateTime @default(now())

  @@unique([jornadaId, usuarioId])
}

// ---------------------------------------------------------------------------
// Auditoria append-only (toda ação relevante + trilha de acesso/exportação)
// ---------------------------------------------------------------------------

model LogAuditoria {
  id          String   @id @default(cuid())
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId   String?
  acao        String // ex.: "passagem.concluir", "historico.exportar"
  entidade    String? // ex.: "PassagemEvento"
  entidadeId  String?
  valorAnterior String?
  valorNovo   String?
  detalhe     String?
  criadoEm    DateTime @default(now())
}
