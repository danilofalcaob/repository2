{
  "name": "passagem-plantao",
  "version": "1.0.0",
  "private": true,
  "description": "CRM de deshospitalização precoce e segura (jornada de alta multiprofissional), passagem de plantão no formato I-PASS e evolução de exames na UTI",
  "scripts": {
    "predev": "node scripts/preparar-ambiente.mjs && node scripts/copiar-ocr.mjs",
    "dev": "next dev",
    "build": "prisma generate && node scripts/copiar-ocr.mjs && next build",
    "vercel-build": "prisma generate && prisma db push && node scripts/copiar-ocr.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:seed:uti": "tsx prisma/seed-uti.ts",
    "setup": "node scripts/preparar-ambiente.mjs",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@prisma/client": "^5.22.0",
    "@tesseract.js-data/por": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.2.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
