# Copie para .env e ajuste os valores.

# Desenvolvimento/demonstração (SQLite):
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL) — troque o provider no prisma/schema.prisma para "postgresql":
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/passagem_plantao?schema=public"

# Segredo para assinatura/validação de sessões (use 32+ caracteres aleatórios).
SESSION_SECRET="defina-um-segredo-forte-e-aleatorio"

# --- UTI · Exames: leitura de laudos por IA (opcional) ---
# Sem chave, a leitura é local (texto do PDF + OCR no navegador).
# ATENÇÃO: com a IA, o laudo (PDF/imagem) é enviado à API da Anthropic —
# use apenas com respaldo institucional/LGPD.
# ANTHROPIC_API_KEY="sk-ant-..."
# EXAMES_IA_MODELO="claude-opus-5-5"
# EXAMES_IA="desligada"
