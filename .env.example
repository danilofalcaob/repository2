# Copie para .env e ajuste os valores.

# Desenvolvimento/demonstração (SQLite):
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL) — troque o provider no prisma/schema.prisma para "postgresql":
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/passagem_plantao?schema=public"

# Segredo para assinatura/validação de sessões (use 32+ caracteres aleatórios).
SESSION_SECRET="defina-um-segredo-forte-e-aleatorio"
