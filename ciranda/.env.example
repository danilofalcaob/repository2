# Copie para .env e ajuste os valores (o `npm run dev` faz isso sozinho na primeira vez).

# Desenvolvimento/demonstração (SQLite):
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL) — troque o provider no prisma/schema.prisma para "postgresql":
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/ciranda?schema=public"

# Segredo para assinatura de sessões (32+ caracteres aleatórios).
SESSION_SECRET="defina-um-segredo-forte-e-aleatorio"
